{
  "name": "@gridwatch/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:push": "pnpm --filter @gridwatch/db push",
    "simulate": "tsx src/cli.ts"
  },
  "dependencies": {
    "@gridwatch/db": "workspace:*",
    "@gridwatch/domain": "workspace:*",
    "@gridwatch/localize": "workspace:*",
    "@gridwatch/schema": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.3",
    "express": "^4.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2"
  }
}