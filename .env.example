# Copy to .env to override defaults. See DEPLOYMENT.md.
# No variable is required to boot.
POSTGRES_URL=postgres://gridwatch:gridwatch@db:5432/gridwatch
PORT=3001
WEB_PORT=3000
SEED_ON_START=true
SEED_SCALE=small
HEARTBEAT_MS=900000
DEBOUNCE_MS=30000
SILENCE_GRACE_MS=120000
VERIFY_THRESHOLD=0.9
AI_API_KEY=
AI_MODEL=gpt-4o-mini
SCHEDULED_OUTAGE_FEED_URL=